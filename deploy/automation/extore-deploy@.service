[Unit]
Description=Extore deployment coordinator

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/extore-deploy/client.py --socket
StandardInput=socket
StandardOutput=inherit
StandardError=inherit
TimeoutStartSec=24min
RuntimeMaxSec=24min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/extore-deploy /home/lightjunction/Backups/servers/archczy/extore
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
