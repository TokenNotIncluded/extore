[Unit]
Description=Dedicated Extore GitHub Actions deployment runner
After=network-online.target extore-deploy.socket
Wants=network-online.target extore-deploy.socket

[Service]
User=extore-runner
Group=extore-runner
WorkingDirectory=/var/lib/extore-actions-runner
ExecStart=/var/lib/extore-actions-runner/run.sh
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=2min
UMask=0077
MemoryMax=1G
TasksMax=256
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/extore-actions-runner
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=127.0.0.0/8
IPAddressAllow=127.0.0.53/32
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=169.254.0.0/16
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10

[Install]
WantedBy=multi-user.target
