EXTORE_ORIGIN=https://extore.lmm.best
EXTORE_DATA=/var/lib/extore
# Upload limits are shared by API and worker. Values below are defaults.
# EXTORE_UPLOAD_FILE_BYTES=20971520
# EXTORE_UPLOAD_JOB_BYTES=104857600
# EXTORE_UPLOAD_JOB_FILES=100
# EXTORE_UPLOAD_SHOP_BYTES=1073741824
# EXTORE_UPLOAD_TOTAL_BYTES=5368709120
# EXTORE_UPLOAD_DISK_RESERVE_BYTES=536870912
# EXTORE_UPLOAD_CONCURRENCY=4
# EXTORE_UPLOAD_TIMEOUT_SECONDS=300
# EXTORE_UPLOAD_DRAFT_TTL_SECONDS=86400
# Configure encrypted SMTP through the platform settings, not this file.
# Public registration and payment adapters are disabled by default.
