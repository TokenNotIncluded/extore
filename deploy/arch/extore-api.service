[Unit]
Description=Extore redemption API
After=network.target

[Service]
User=extore
Group=extore
EnvironmentFile=/etc/extore/extore.env
Environment=EXTORE_STATIC=/usr/lib/extore/extore/static
Environment=EXTORE_LISTEN=127.0.0.1:8095
WorkingDirectory=/var/lib/extore
ExecStart=/usr/lib/extore/bin/extore serve
Restart=on-failure
RestartSec=5
StateDirectory=extore
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/extore
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
