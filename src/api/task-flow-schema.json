{
  "$defs": {
    "fieldKey": {
      "pattern": "^[a-z][a-z0-9_]{0,39}(?![\\s\\S])",
      "type": "string"
    },
    "fieldLabel": {
      "additionalProperties": {
        "maxLength": 200,
        "pattern": "^[^\\u0000]*(?![\\s\\S])",
        "type": "string"
      },
      "maxProperties": 20,
      "minProperties": 1,
      "not": {
        "additionalProperties": {
          "pattern": "^\\s*$"
        }
      },
      "propertyNames": {
        "maxLength": 40,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "i18n": {
      "additionalProperties": {
        "maxLength": 10000,
        "pattern": "^[^\\u0000]*(?![\\s\\S])",
        "type": "string"
      },
      "maxProperties": 20,
      "propertyNames": {
        "maxLength": 40,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "inputField": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "required": [
              "max_items"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "images"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "else": {
            "not": {
              "required": [
                "sensitive_ttl_seconds"
              ]
            }
          },
          "if": {
            "properties": {
              "sensitive": {
                "const": true
              }
            },
            "required": [
              "sensitive"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          }
        }
      ],
      "properties": {
        "collapsed": {
          "default": true,
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/i18n"
        },
        "key": {
          "$ref": "#/$defs/fieldKey"
        },
        "label": {
          "$ref": "#/$defs/fieldLabel"
        },
        "max_items": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/option"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "sensitive": {
          "default": false,
          "type": "boolean"
        },
        "sensitive_ttl_seconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "default": "text",
          "enum": [
            "boolean",
            "email",
            "file",
            "image",
            "images",
            "number",
            "select",
            "text",
            "textarea",
            "url"
          ]
        }
      },
      "required": [
        "key",
        "label"
      ],
      "type": "object"
    },
    "mapping": {
      "additionalProperties": {
        "$ref": "#/$defs/reference"
      },
      "maxProperties": 30,
      "propertyNames": {
        "$ref": "#/$defs/fieldKey"
      },
      "type": "object"
    },
    "next": {
      "oneOf": [
        {
          "$ref": "#/$defs/nodeId"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cases": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "to": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "when": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "op": {
                            "const": "exists"
                          },
                          "source": {
                            "$ref": "#/$defs/reference"
                          }
                        },
                        "required": [
                          "source",
                          "op"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "op": {
                            "const": "eq"
                          },
                          "source": {
                            "$ref": "#/$defs/reference"
                          },
                          "value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "op",
                          "value"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "op": {
                            "const": "in"
                          },
                          "source": {
                            "$ref": "#/$defs/reference"
                          },
                          "value": {
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 50,
                            "minItems": 1,
                            "type": "array"
                          }
                        },
                        "required": [
                          "source",
                          "op",
                          "value"
                        ],
                        "type": "object"
                      }
                    ]
                  }
                },
                "required": [
                  "when",
                  "to"
                ],
                "type": "object"
              },
              "maxItems": 32,
              "minItems": 1,
              "type": "array"
            },
            "default": {
              "$ref": "#/$defs/nodeId"
            }
          },
          "required": [
            "cases",
            "default"
          ],
          "type": "object"
        }
      ]
    },
    "nodeId": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
      "type": "string"
    },
    "nodeLabel": {
      "additionalProperties": {
        "maxLength": 200,
        "pattern": "^[^\\u0000]*(?![\\s\\S])",
        "type": "string"
      },
      "maxProperties": 20,
      "propertyNames": {
        "maxLength": 40,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])",
        "type": "string"
      },
      "type": "object"
    },
    "option": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/fieldLabel"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "outputField": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "required": [
              "max_items"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "images"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        {
          "else": {
            "not": {
              "required": [
                "sensitive_ttl_seconds"
              ]
            }
          },
          "if": {
            "properties": {
              "sensitive": {
                "const": true
              }
            },
            "required": [
              "sensitive"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          }
        }
      ],
      "properties": {
        "collapsed": {
          "default": true,
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/i18n"
        },
        "key": {
          "$ref": "#/$defs/fieldKey"
        },
        "label": {
          "$ref": "#/$defs/fieldLabel"
        },
        "max_items": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/option"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "required": {
          "default": true,
          "type": "boolean"
        },
        "sensitive": {
          "const": false
        },
        "sensitive_ttl_seconds": {
          "default": 120,
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "default": "text",
          "enum": [
            "boolean",
            "email",
            "file",
            "image",
            "images",
            "number",
            "select",
            "text",
            "textarea",
            "url"
          ]
        }
      },
      "required": [
        "key",
        "label"
      ],
      "type": "object"
    },
    "reference": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldKey"
        },
        "node": {
          "$ref": "#/$defs/nodeId"
        }
      },
      "required": [
        "node",
        "field"
      ],
      "type": "object"
    }
  },
  "$id": "https://extore.lmm.best/api/task-flows/schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Declarative customer-input, processing, display and terminal nodes. Null preserves the simple redemption path. Server validation also checks product field compatibility, graph references, reachability, UTF-8 encoded size and snapshot size before publication.",
  "oneOf": [
    {
      "type": "null"
    },
    {
      "additionalProperties": false,
      "properties": {
        "entry": {
          "$ref": "#/$defs/nodeId"
        },
        "nodes": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "allOf": [
                  {
                    "else": {
                      "not": {
                        "required": [
                          "timeout_next"
                        ]
                      }
                    },
                    "if": {
                      "properties": {
                        "timeout_seconds": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "timeout_seconds"
                      ]
                    },
                    "then": {
                      "required": [
                        "timeout_next"
                      ]
                    }
                  }
                ],
                "properties": {
                  "fields": {
                    "items": {
                      "$ref": "#/$defs/inputField"
                    },
                    "maxItems": 30,
                    "type": "array"
                  },
                  "id": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "kind": {
                    "const": "input"
                  },
                  "label": {
                    "$ref": "#/$defs/nodeLabel"
                  },
                  "next": {
                    "$ref": "#/$defs/next"
                  },
                  "prompt": {
                    "$ref": "#/$defs/i18n"
                  },
                  "question": {
                    "$ref": "#/$defs/i18n"
                  },
                  "show_from": {
                    "$ref": "#/$defs/mapping"
                  },
                  "start_policy": {
                    "default": "confirm",
                    "enum": [
                      "confirm",
                      "automatic"
                    ]
                  },
                  "timeout_next": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "timeout_seconds": {
                    "default": null,
                    "maximum": 86400,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "fields",
                  "next"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "failure_next": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "id": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "inputs": {
                    "$ref": "#/$defs/mapping"
                  },
                  "kind": {
                    "const": "process"
                  },
                  "label": {
                    "$ref": "#/$defs/nodeLabel"
                  },
                  "next": {
                    "$ref": "#/$defs/next"
                  },
                  "outputs": {
                    "items": {
                      "$ref": "#/$defs/outputField"
                    },
                    "maxItems": 30,
                    "type": "array"
                  },
                  "timeout_next": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "timeout_seconds": {
                    "default": 3600,
                    "maximum": 86400,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "inputs",
                  "outputs",
                  "next",
                  "failure_next",
                  "timeout_next"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "allOf": [
                  {
                    "else": {
                      "not": {
                        "required": [
                          "timeout_next"
                        ]
                      }
                    },
                    "if": {
                      "properties": {
                        "timeout_seconds": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "timeout_seconds"
                      ]
                    },
                    "then": {
                      "required": [
                        "timeout_next"
                      ]
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "result",
                        "show_from"
                      ]
                    }
                  }
                ],
                "properties": {
                  "content": {
                    "$ref": "#/$defs/i18n"
                  },
                  "id": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "kind": {
                    "const": "display"
                  },
                  "label": {
                    "$ref": "#/$defs/nodeLabel"
                  },
                  "next": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "result": {
                    "$ref": "#/$defs/mapping",
                    "deprecated": true,
                    "description": "Legacy alias of show_from; cannot be used together."
                  },
                  "show_from": {
                    "$ref": "#/$defs/mapping"
                  },
                  "timeout_next": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "timeout_seconds": {
                    "default": null,
                    "maximum": 86400,
                    "minimum": 1,
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "next"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "state": {
                          "enum": [
                            "failed",
                            "rejected"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "result": {
                          "maxProperties": 0
                        }
                      }
                    }
                  }
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "kind": {
                    "const": "end"
                  },
                  "label": {
                    "$ref": "#/$defs/nodeLabel"
                  },
                  "message": {
                    "$ref": "#/$defs/i18n"
                  },
                  "needs_review": {
                    "default": false,
                    "type": "boolean"
                  },
                  "result": {
                    "$ref": "#/$defs/mapping"
                  },
                  "retryable": {
                    "default": false,
                    "type": "boolean"
                  },
                  "state": {
                    "enum": [
                      "succeeded",
                      "failed",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "state"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "entry",
        "nodes"
      ],
      "type": "object"
    }
  ],
  "title": "Extore task-flow definition v1",
  "x-extore-limits": {
    "definition_bytes": 100000,
    "node_count": 64,
    "snapshot_bytes": 200000,
    "transition_count": 256
  }
}
